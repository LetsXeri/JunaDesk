{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JunaDesk",
  "version": "0.1.6",
  "identifier": "io.github.letsxeri.junadesk",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "JunaDesk",
        "width": 1100,
        "height": 720,
        "backgroundColor": "#0B0E19",
        "minWidth": 560,
        "minHeight": 480,
        "visible": false,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; style-src 'self'; media-src asset: http://asset.localhost; connect-src ipc: http://ipc.localhost",
      "assetProtocol": { "enable": true, "scope": ["$APPLOCALDATA/wallpapers/**"] }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRBQzg1RjMyRjNGNUI3M0QKUldROXQvWHpNbC9JU25ic3Jldk9HaEJnTTJTUnU3alVJbnpCZ0I1U0pISmxzbXJBTE13bWMvVmUK",
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "resources": { "resources/": "tools/" },
    "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"]
  }
}
